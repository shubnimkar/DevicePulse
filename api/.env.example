# ── Required ──────────────────────────────────────────────────────────────────
# MongoDB connection string.
# Local:   MONGO_URI=mongodb://localhost:27017
# Atlas:   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb://localhost:27017

# ── Admin authentication ───────────────────────────────────────────────────────
# Secret header value required for POST /update/release and POST /policy.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=change-me-in-production

# ── Dashboard read authentication ─────────────────────────────────────────────
# Token required on all GET endpoints (/devices, /alerts/*, /focus/*).
# Must match NEXT_PUBLIC_DASHBOARD_TOKEN in the dashboard .env.local.
# If unset, read endpoints are unauthenticated (local dev only).
# Generate with: openssl rand -hex 32
DASHBOARD_TOKEN=change-me-in-production

# ── Optional ──────────────────────────────────────────────────────────────────
# Port the API listens on (default: 8080).
# PORT=8080
NEXT_PUBLIC_API_URL=https://your-production-domain.com
