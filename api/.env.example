# ── Required ──────────────────────────────────────────────────────────────────
# MongoDB connection string.
# Local:   MONGO_URI=mongodb://localhost:27017
# Atlas:   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb://localhost:27017

# ── Dashboard session signing ──────────────────────────────────────────────────
# HMAC key for session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-strong-random-secret
# (If unset, SESSION_SECRET falls back to ADMIN_SECRET for single-secret setups.)

# ── CORS ───────────────────────────────────────────────────────────────────────
# Exact browser origin allowed to send credentialed requests. Only this origin
# (plus DASHBOARD_EXTRA_ORIGINS) is reflected — no wildcard matching.
DASHBOARD_ORIGIN=http://localhost:3000
# DASHBOARD_EXTRA_ORIGINS=http://127.0.0.1:3000,https://staging.example.com

# ── Rate limiting (requests/minute per client IP; 0 disables) ──────────────────
LOGIN_RATE_LIMIT_PER_MINUTE=30
REGISTER_RATE_LIMIT_PER_MINUTE=10

# ── Cookies ────────────────────────────────────────────────────────────────────
# Set true when serving over HTTPS so the session cookie is Secure-only.
COOKIE_SECURE=false

# ── Legacy / optional ──────────────────────────────────────────────────────────
# No longer an API gate: privileged routes are role-gated by dashboard sessions
# (viewer < manager < admin). ADMIN_SECRET is only used as the SESSION_SECRET
# fallback above.
ADMIN_SECRET=

# Port the API listens on (default: 8000).
# PORT=8000
