# ── API endpoint ──────────────────────────────────────────────────────────────
# URL of the DevicePulse API — no trailing slash.
# Overrides the value baked in at build time with -ldflags.
# For local dev this default works out of the box.
# For production, set this to your public API domain.
DEVICEPULSE_API_URL=http://localhost:8080

# ── Data directory ────────────────────────────────────────────────────────────
# Where the agent stores its SQLite queue and registration.json.
# Defaults to /var/lib/devicepulse (Linux/macOS) or
# C:\ProgramData\DevicePulse\Agent (Windows) when unset.
# Useful for local dev to avoid needing root-owned directories.
# DEVICEPULSE_DATA_DIR=./data

# ── Mode ──────────────────────────────────────────────────────────────────────
# Leave unset for full collection (default).
# Set to "window_only" for the Linux per-user session service that only
# tracks the active window and shares the root service's SQLite queue.
# DEVICEPULSE_MODE=window_only
