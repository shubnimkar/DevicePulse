# Docker Compose variables. Local defaults use the Next.js /api proxy.
NEXT_PUBLIC_API_URL=/api
DASHBOARD_ORIGIN=http://localhost:3000
API_BIND_ADDRESS=127.0.0.1
DASHBOARD_BIND_ADDRESS=127.0.0.1

# Production behind nginx on this host:
# DASHBOARD_ORIGIN=https://devicepulse.waybeyond.tech
# PUBLIC_API_URL=https://devicepulse.waybeyond.tech/api
# Keep NEXT_PUBLIC_API_URL=/api; the container proxy uses http://api:8000.
# Set COOKIE_SECURE=true in api/.env as an explicit production setting.
