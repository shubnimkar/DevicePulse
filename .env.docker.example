# Values consumed by docker-compose.yml.
#
# Local development:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#   DASHBOARD_ORIGIN=http://localhost:3000
#
# Production behind nginx on the same domain:
#   NEXT_PUBLIC_API_URL=https://devicepulse.waybeyond.tech
#   DASHBOARD_ORIGIN=https://devicepulse.waybeyond.tech

NEXT_PUBLIC_API_URL=http://localhost:8000
DASHBOARD_ORIGIN=http://localhost:3000
